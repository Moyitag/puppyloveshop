# Variables necesarias para iniciar el backend
DB_URI=mongodb://localhost:27017/puppyloveshop
PORT=4000
JWT_SECRET_KEY=cambia-esta-clave-por-una-secreta-y-larga

# Recuperación de contraseña por correo. Con Gmail, usa una contraseña de aplicación.
USER_EMAIL=tu-correo@gmail.com
USER_PASSWORD=tu-contrasena-de-aplicacion

# Opcional: servidor SMTP distinto de Gmail
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
